rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /work_queue_assignments/{spoolId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['spoolKey', 'ownerUid', 'ownerEmail', 'claimedAt']);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['spoolKey', 'ownerUid', 'ownerEmail', 'claimedAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // SIOP Meeting Tracker (2026-11-12). Any signed-in user can read and add notes;
    // nobody can edit or delete an update, so the history stays whole.
    function momStatusOk(s) { return s in ['Open', 'Hold', 'Closed', 'Cancelled']; }
    function momCaseOk(d) {
      return d.keys().hasOnly(['caseId', 'project', 'dept', 'status', 'firstRaised', 'lastUpdated', 'updateCount', 'latest'])
        && d.keys().hasAll(['caseId', 'project', 'status', 'firstRaised', 'lastUpdated', 'latest'])
        && d.caseId is string
        && d.project is string && d.project.size() > 0 && d.project.size() <= 80
        && (!('dept' in d) || (d.dept is string && d.dept.size() <= 40))
        && momStatusOk(d.status)
        && d.firstRaised is string && d.lastUpdated is string
        && d.latest is map && d.latest.remarks is string && d.latest.remarks.size() <= 2000;
    }

    match /mom_cases/{caseId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && momCaseOk(request.resource.data)
        && request.resource.data.caseId == caseId;
      allow update: if signedIn()
        && momCaseOk(request.resource.data)
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.project == resource.data.project
        && request.resource.data.firstRaised == resource.data.firstRaised;
      allow delete: if false;
    }

    match /mom_updates/{updateId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['caseId', 'project', 'dept', 'date', 'status', 'remarks', 'items', 'createdByUid', 'createdByEmail', 'createdAt'])
        && request.resource.data.keys().hasAll(['caseId', 'project', 'date', 'status', 'remarks', 'createdByUid', 'createdAt'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && momStatusOk(request.resource.data.status)
        && request.resource.data.caseId is string
        && request.resource.data.project is string && request.resource.data.project.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.remarks is string && request.resource.data.remarks.size() <= 2000
        && (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 40));
      allow update, delete: if false;
    }

    match /work_handoffs/{handoffId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'spoolKey', 'projectCode', 'projectName', 'drawingNo', 'spoolNo',
          'currentStage', 'nextStage', 'statusMessage', 'fromDepartment',
          'toDepartment', 'note', 'attachment', 'status', 'createdByUid', 'createdByEmail', 'createdAt'
        ]);
      allow update: if signedIn()
        && resource.data.status == 'open'
        && request.resource.data.status in ['acknowledged', 'clarification_requested']
        && request.resource.data.respondedByUid == request.auth.uid
        && request.resource.data.spoolKey == resource.data.spoolKey
        && request.resource.data.keys().hasOnly([
          'spoolKey', 'projectCode', 'projectName', 'drawingNo', 'spoolNo',
          'currentStage', 'nextStage', 'statusMessage', 'fromDepartment',
          'toDepartment', 'note', 'attachment', 'status', 'createdByUid', 'createdByEmail', 'createdAt',
          'responseNote', 'respondedByUid', 'respondedByEmail', 'respondedAt'
        ]);
      allow delete: if false;
    }
  }
}

