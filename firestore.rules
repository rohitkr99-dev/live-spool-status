rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /work_queue_assignments/{spoolId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['spoolKey', 'ownerUid', 'ownerEmail', 'claimedAt']);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['spoolKey', 'ownerUid', 'ownerEmail', 'claimedAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // SIOP Meeting Tracker (2026-11-12). One running record per project (mom_projects)
    // and one note per meeting (mom_notes). Any signed-in user can read and add notes;
    // nobody can edit or delete a note, so the history stays whole.
    function momProjectOk(d) {
      return d.keys().hasOnly(['projectId', 'project', 'firstDate', 'lastUpdated', 'updateCount', 'latest'])
        && d.keys().hasAll(['projectId', 'project', 'firstDate', 'lastUpdated', 'latest'])
        && d.projectId is string
        && d.project is string && d.project.size() > 0 && d.project.size() <= 80
        && d.firstDate is string && d.lastUpdated is string
        && d.latest is map && d.latest.remarks is string && d.latest.remarks.size() <= 2000;
    }

    match /mom_projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && momProjectOk(request.resource.data)
        && request.resource.data.projectId == projectId;
      allow update: if signedIn()
        && momProjectOk(request.resource.data)
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.project == resource.data.project
        && request.resource.data.firstDate == resource.data.firstDate;
      allow delete: if false;
    }

    match /mom_notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['projectId', 'project', 'dept', 'date', 'remarks', 'items', 'createdByUid', 'createdByEmail', 'createdAt'])
        && request.resource.data.keys().hasAll(['projectId', 'project', 'date', 'remarks', 'createdByUid', 'createdAt'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.projectId is string
        && request.resource.data.project is string && request.resource.data.project.size() > 0 && request.resource.data.project.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.remarks is string && request.resource.data.remarks.size() <= 2000
        && (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 40));
      allow update, delete: if false;
    }

    match /work_handoffs/{handoffId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'spoolKey', 'projectCode', 'projectName', 'drawingNo', 'spoolNo',
          'currentStage', 'nextStage', 'statusMessage', 'fromDepartment',
          'toDepartment', 'note', 'attachment', 'status', 'createdByUid', 'createdByEmail', 'createdAt'
        ]);
      allow update: if signedIn()
        && resource.data.status == 'open'
        && request.resource.data.status in ['acknowledged', 'clarification_requested']
        && request.resource.data.respondedByUid == request.auth.uid
        && request.resource.data.spoolKey == resource.data.spoolKey
        && request.resource.data.keys().hasOnly([
          'spoolKey', 'projectCode', 'projectName', 'drawingNo', 'spoolNo',
          'currentStage', 'nextStage', 'statusMessage', 'fromDepartment',
          'toDepartment', 'note', 'attachment', 'status', 'createdByUid', 'createdByEmail', 'createdAt',
          'responseNote', 'respondedByUid', 'respondedByEmail', 'respondedAt'
        ]);
      allow delete: if false;
    }
  }
}

